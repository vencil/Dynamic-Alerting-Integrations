{
  "name": "Dynamic Alerting Integrations",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    // 1. Docker-in-Docker (Kind 核心)
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    },
    // 2. K8s 工具 (kubectl, helm)
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "minikube": "none",
      "kubectl": "latest",
      "helm": "latest"
    },
    // 3. Node.js (很多 MCP connector 需要)
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    // 4. Go (threshold-exporter 開發用)
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.23"
    },
    // 5. Python (確保有 pip)
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13",
      "installTools": true
    }
  },
  
  // [UPDATED] 環境建立後的自動化指令：
  // 1. 安裝 Python 測試/工具依賴：
  //    - pyyaml：運行時依賴
  //    - pytest-benchmark：tests/ops/test_benchmark.py 的效能基線（缺它
  //      collection 階段會炸 14 個 ERROR）
  //    - pytest-xdist：`make test` 預設 -n auto（ROI r6 D 波）；缺它
  //      pytest 直接 unrecognized arguments 炸
  //    - mkdocs-material / mkdocs-static-i18n / pymdown-extensions：
  //      `make lint-docs-mkdocs` 需要的三件組（dev-rules.md #4 Doc-as-Code
  //      要求 docs/**.md push 前必跑此 lint；缺它就只能等 CI 回報 site-root
  //      vs filesystem path 語意衝突）。PR #375 從踩到的痛中加進來。
  // 2. 安裝 Kind
  // 3. 安裝 promtool（pinned，與 ci.yml 同版——手裝 2.x vs CI pin 3.x 的
  //    lookback 語意 skew 燒過 #1134；pin parity 由
  //    tests/preview/test_promtool_pin_parity.py 顧）
  // 4. 安裝 vector（pinned，與 ci.yml 同版、且與 chart 實際部署的版本同版）。
  //    沒有它時 tests/shared/test_vector_projection_vrl.py 的
  //    TestVectorValidateAndTest（`vector validate` ×3 + `vector test` 跑
  //    helm/vector/tests/projection_tests.yaml）會整組 skip——那是出貨 VRL
  //    唯一被「執行」而非字串比對的地方（租戶 fail-closed 路由、ADR-028 §D3
  //    PII 丟棄、#1293 origin-spoof 真值表）。少了它，VRL 改動只能推上去等 CI，
  //    而 #1293 正是那個往返成本的實例。pin parity 由
  //    tests/shared/test_vector_pin_parity.py 顧。
  // The pip set MUST stay a superset of what the ci.yml job running the full
  // pytest suite installs — enforced by check_devcontainer_dep_parity.py
  // (#1254). A package CI has and the container lacks does not fail tests, it
  // makes them skip themselves, so the container reports a greener result
  // than CI (measured: 28 tests silently skipped). Keep the trailing
  // `-c requirements/ci-constraints.txt` so versions match CI's pins.
  //
  // ⛔ NO `--user` here, and NO `sudo` either — both are load-bearing:
  //   * `--user` installs into the HOME of whoever runs the lifecycle script.
  //     Per the devcontainer spec that is `remoteUser` (vscode), but this
  //     config sets no `containerUser`, so `Config.User` stays root and a bare
  //     `docker exec` — which CLAUDE.md and the playbooks document, and which
  //     scripts/ops/dx_run.py uses — lands as ROOT with none of these packages.
  //     A clean rebuild then broke `make dc-test` outright
  //     (`ModuleNotFoundError: No module named 'yaml'`) and `make
  //     lint-docs-mkdocs` (`REASON=mkdocs-missing`). Installing system-wide
  //     makes the set user-agnostic, matching how the Go and Node features
  //     already work here (GOPATH=/go, npm prefix under /usr/local/share/nvm
  //     are identical for both users) and matching ci.yml, which also installs
  //     without `--user`.
  //   * `sudo` is NOT needed: site-packages is `vscode:python` mode 2775, i.e.
  //     writable by remoteUser already. Worse, it would BREAK container
  //     creation — sudoers' secure_path excludes /usr/local/python/current/bin,
  //     so `sudo pip3` is "command not found", and this is an `&&` chain, so
  //     kind and promtool would silently never install.
  // Deliberately NOT fixed here: whether tooling should exec as vscode instead
  // of root. On this Windows host the bind mount presents files as root:root,
  // so git refuses to run as vscode ("detected dubious ownership"), which takes
  // out `go build` VCS stamping and every git-shelling lint. That is a separate
  // decision — see the issue linked from CHANGELOG.
  "postCreateCommand": "pip3 install pyyaml croniter pytest pytest-cov pytest-timeout pytest-xdist promql-parser hypothesis pathspec jsonschema check-jsonschema pytest-benchmark mkdocs-material mkdocs-static-i18n pymdown-extensions -c requirements/ci-constraints.txt && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.20.0/kind-linux-amd64 && chmod +x ./kind && sudo mv ./kind /usr/local/bin/kind && bash .devcontainer/install-promtool.sh && bash .devcontainer/install-vector.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-python.python"
      ],
      // #658: wire the tenant-config JSON Schema to conf.d tenant YAML so
      // authors get inline validation + autocomplete in-container. The `[^_]`
      // char-class EXCLUDES platform files (_profiles / _routing* / _rbac ...)
      // whose shapes differ from the tenant schema. We inject this here (not
      // .vscode/settings.json — that path is gitignored: .gitignore `.vscode/*`)
      // so the association ships with the dev container.
      // _defaults*.yaml get the platform-defaults schema (top-level key guard,
      // #658 fast-follow) — same schema the CI confd-schema-check validates them
      // against, so the editor and CI agree (cross-surface consistency).
      // Non-container editors: see docs/internal/editor-schema-validation.md.
      "settings": {
        "yaml.schemas": {
          "./docs/schemas/tenant-config.schema.json": [
            "**/conf.d/[^_]*.yaml",
            "**/conf.d/**/[^_]*.yaml"
          ],
          "./docs/schemas/platform-defaults.schema.json": [
            "**/conf.d/_defaults*.yaml",
            "**/conf.d/**/_defaults*.yaml"
          ]
        }
      }
    }
  },
  
  // 給予容器特權以運行 K8s
  "runArgs": [
    "--privileged", 
    "--name", "vibe-dev-container"
  ]
}
