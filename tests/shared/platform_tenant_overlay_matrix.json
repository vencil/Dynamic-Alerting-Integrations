      },
      "expect": {
        "tx": {
          "metric": 70,
          "dedup": "enable",
          "group_wait": null,
          "exporter_dedup": "enable",
          "silent_mode": "",
          "walker": {
            "effective_config": {
              "mysql_connections": "70"
            },
            "platform_overlay": null
          }
        }
      }
    },
