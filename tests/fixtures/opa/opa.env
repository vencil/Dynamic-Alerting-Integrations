# OPA the documented rego examples are evaluated on (#4110): the one pin.
# Read by .github/workflows/ci.yml's `Lint Documentation` job, which downloads
# opa_linux_amd64_static of OPA_VERSION and verifies OPA_SHA256 before running
# it, and by tests/ops/test_rego_examples.py, which refuses an OPA of another
# version. Raise both lines together; take the checksum from the release's
# opa_linux_amd64_static.sha256 and check it against the downloaded file.
OPA_VERSION=v1.4.2
OPA_SHA256=2c0ccdbbe0b8e2a5d12d9c42d92f1f34f494ffb32d1f3c4ddc36101be637d66f
