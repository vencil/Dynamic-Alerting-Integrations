// Test-scoped module: keeps the oauth2-proxy dependency OUT of the
// production Go modules, whose go.mod feeds image builds, Trivy scans and
// release provenance. Nothing here is built into an artifact — it loads the
// tenant-api chart's oauth2-proxy config file with oauth2-proxy's own loader,
// header injector and upstream router (ADR-027 §9 item 9).
//
// The oauth2-proxy dependency is pinned to the version the tenant-api chart
// deploys (helm/tenant-api/values.yaml oauth2Proxy.image.tag);
// TestLibraryVersionIsTheChartImage fails when the two differ.
module github.com/vencil/dynamic-alerting/tests/oauth2-proxy

go 1.26.10

require (
	github.com/justinas/alice v1.2.0
	github.com/oauth2-proxy/oauth2-proxy/v7 v7.15.5
	gopkg.in/yaml.v3 v3.0.1
)

require (
	cloud.google.com/go/auth v0.23.3 // indirect
	cloud.google.com/go/auth/oauth2adapt v0.2.8 // indirect
	cloud.google.com/go/compute/metadata v0.10.0 // indirect
