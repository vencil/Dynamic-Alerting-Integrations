# Run-time fixture stage (driver writes/mutates here per run);
# generated from the kind-specific dirs below at harness startup.
fixture/active/

# Generated fixtures (large) — produced by
# scripts/tools/dx/generate_tenant_fixture.py on demand.
# fixture/synthetic-v1/ and fixture/synthetic-v2/ are local-only and wholly
# generated by scripts/ops/bench_e2e_run.sh. No placeholder is tracked (#1443):
# the script discarded its values on every run, and a restored placeholder
# beside leftover generated tenants made a stale mixed tree.
fixture/synthetic-v1/
fixture/synthetic-v2/

# Customer anonymized samples never enter version control.
fixture/customer-anon/conf.d/

# Per-run JSON output from driver.
bench-results/
