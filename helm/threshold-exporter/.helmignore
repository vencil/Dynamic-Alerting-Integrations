# Patterns to ignore when building Helm chart packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.

# Go source & Dockerfile (image 獨立 build)
app/

# Directory Scanner 開發範本 (不屬於 chart)
config/

# Documentation (README 不需進 chart .tgz)
README.md

# Version control
.git
.gitignore

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# #1018: the Pod Security gate's value sets (tests/pss). They are inputs to
# that test, not deployment profiles, and must not ship in the .tgz
# (check_chart_package_contents.py DECLARED_SUBTREES lists templates only).
# helm template/-f reads them from the source tree regardless of this line.
ci/

# #3353: the Container SAST L2 render variant (check_iac_helm.py lints every
# root values*.yaml) that turns the config-validation CronJob on. An input to
# that gate, not a deployment profile; not in the .tgz.
values-config-validation.yaml
