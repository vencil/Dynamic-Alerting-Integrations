{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "da-portal values",
  "description": "Static-only portal (ADR-027 §5). additionalProperties is false at every level so a values file that still sets a removed key (oauth2Proxy, ingress, portal.tenantApiUrl, portal.recipePreviewUrl, portal.relayToken, service.internalPort, networkPolicy.egress, …) fails the install instead of being silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listenPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "customData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"type": "string", "enum": ["configMap", "emptyDir"]},
        "configMapName": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object"},
        "limits": {"type": "object"}
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedNamespaces": {
          "description": "At least one: an empty `from:` would admit every source.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
