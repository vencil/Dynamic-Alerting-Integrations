{
  "schema": "da-guard.compile-custom-alerts/v1",
  "config_hash": "52288814bb386bd985ea1713ac5b51d1e5c4ff7ada90fa3bf2d45f08e309bcb8",
  "groups": [
    {
      "name": "custom-alerts-normalization",
      "interval": "15s",
      "rules": [
        {
          "record": "custom:threshold:threshold__qd__gt__w5m__for1m",
          "expr": "label_replace(max by(tenant, version, severity, name, mode) (user_threshold{component=\"custom\", metric=\"qd\", recipe_id=\"threshold__qd__gt__w5m__for1m\"}) and on(tenant, version, severity) (count by(tenant, version, severity) (max by(tenant, version, severity, name, mode) (user_threshold{component=\"custom\", metric=\"qd\", recipe_id=\"threshold__qd__gt__w5m__for1m\"})) == 1), \"version\", \"default\", \"version\", \"^$\")"
        },
        {
          "record": "custom:metric:threshold__qd__gt__w5m__for1m",
          "expr": "label_replace(max by(tenant, version, da_cluster) (qd), \"version\", \"default\", \"version\", \"^$\")"
        },
        {
          "record": "custom:threshold__qd__gt__w5m__for1m:warning:core",
          "expr": "(\n  (\n    custom:metric:threshold__qd__gt__w5m__for1m\n    > on(tenant, version) group_left(name, mode)\n      custom:threshold:threshold__qd__gt__w5m__for1m{severity=\"warning\"}\n  )\n  or\n  (\n    (\n      custom:metric:threshold__qd__gt__w5m__for1m\n      unless on(tenant, version)\n        custom:threshold:threshold__qd__gt__w5m__for1m{severity=\"warning\"}\n    )\n    > on(tenant) group_left(name, mode)\n      custom:threshold:threshold__qd__gt__w5m__for1m{version=\"default\", severity=\"warning\"}\n  )\n)\nunless on(tenant)\n(user_state_filter{filter=\"maintenance\"} == 1)"
        }
      ]
    },
    {
      "name": "custom-alerts-info",
      "interval": "1m",
      "rules": [
        {
          "record": "custom_recipe_info",
          "expr": "vector(1)",
          "labels": {
            "recipe_id": "threshold__qd__gt__w5m__for1m",
            "recipe": "threshold",
            "status": "active"
          }
        }
      ]
    },
    {
      "name": "custom-alerts",
      "rules": [
        {
          "alert": "CustomRecipeSilent",
          "expr": "max by(tenant, name) (user_threshold{component=\"custom\", mode=\"silent\"})",
          "labels": {
            "severity": "none",
            "maintenance": "page",
            "component": "sentinel",
            "tenant": "{{ $labels.tenant }}",
            "name": "{{ $labels.name }}"
          },
          "annotations": {
            "summary": "Custom recipe [{{ $labels.name }}] is silent for {{ $labels.tenant }}",
            "summary_zh": "{{ $labels.tenant }} 的自訂告警 [{{ $labels.name }}] 處於靜默模式",
            "description": "The recipe is still evaluated and visible as an ALERTS series (dashboard-only); its notifications are suppressed via inhibit, not deleted.",
            "description_zh": "此自訂告警仍會評估並可於監控面板（ALERTS series）查看，通知經 inhibit 抑制而非刪除。",
            "runbook_url": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.runbook_url }}{{ end }}{{ end }}",
            "owner": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.owner }}{{ end }}{{ end }}",
            "tier": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.tier }}{{ end }}{{ end }}"
          }
        },
        {
          "alert": "Custom_threshold__qd__gt__w5m__for1m",
          "expr": "custom:threshold__qd__gt__w5m__for1m:warning:core",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "maintenance": "mute",
            "tenant": "{{ $labels.tenant }}",
            "recipe": "threshold",
            "component": "custom",
            "mode": "{{ $labels.mode }}"
          },
          "annotations": {
            "summary": "Custom alert [{{ $labels.name }}] for {{ $labels.tenant }}",
            "summary_zh": "{{ $labels.tenant }} 的自訂告警 [{{ $labels.name }}] 觸發",
            "description": "threshold on qd: value {{ $value | printf \"%.2f\" }} crossed the configured threshold",
            "description_zh": "qd 的 threshold: 值 {{ $value | printf \"%.2f\" }} 已越過設定閾值",
            "runbook_url": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.runbook_url }}{{ end }}{{ end }}",
            "owner": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.owner }}{{ end }}{{ end }}",
            "tier": "{{ with query (printf `topk(1, tenant_metadata_info{tenant=%q})` $labels.tenant) }}{{ with index . 0 }}{{ .Labels.tier }}{{ end }}{{ end }}"
          }
        }
      ]
    }
  ],
  "shapes": 1,
  "declarations": {},
  "not_compiled": [],
  "block_errors": {},
  "lifecycle": [],
  "parse_failed": [],
  "skipped": [],
  "unreadable": []
}
