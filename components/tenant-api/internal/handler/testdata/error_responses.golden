# Error → response golden (#3226). Generated by TestErrorResponses_Golden; regenerate with
# UPDATE_GOLDEN=1 and review every changed line: each is a changed answer.
# Every error is fed to every entry, including errors the entry never receives in production.
# Grouped by answer: each answer once, then "  <- " and the sorted inputs that get it. [hidden] / [visible]:
# a caller treePathsVisible does not / does admit, when the two are answered differently.
# "x ≡ %w": x and x %w-wrapped once get the same answer. "no response (<return>): …" lists the
# inputs an entry writes nothing for. Scenario rows (no error input) are "<scenario> => <answer>".
# counted = tenant_api_writes_total result of the attempt (fault from the entry or its caller wins).

## Fixed texts named below
msgInternal = "internal error; the server log has the details under this request_id"
msgWriteFailed = "the write failed; the server log has the details under this request_id"
msgBatchOpFailed = "the write failed; the server log has the details"
msgWriteCancelled = "the write was cancelled or timed out before it was committed; nothing was written, so it is safe to retry"
msgWriteOutcomeUnknown = "the write failed while it was being committed and the server cannot tell whether it was; it may have been committed — refresh to see whether it was before retrying"
msgTenantDeclaredElsewhere = "tenant id is declared by another conf.d file (or by several); conf.d must declare each tenant exactly once"
msgTenantFileDirty = "the tenant's config file has uncommitted changes made outside tenant-api; nothing was written — commit or discard them in the repository, then retry"
msgTenantTreeScan = "cannot verify where the tenant is declared in conf.d; nothing was written"
msgGitPushFailed = "pushing the change to the config repository failed; no PR/MR was opened — please retry"
msgBatchConflict = "conflict: the repository changed outside tenant-api while the batch ran; nothing was written — refresh and retry"
msgBatchCommittedIncomplete = "the batch WAS committed, but the write did not finish cleanly on the server; refresh before changing anything (do not resend the batch blindly)"
msgGeneratorTooLarge = "the files this write produces are too large for the generator to judge in one request; nothing was written — split the batch into smaller ones"
msgGitDriverConfigured = "the server cannot check or write tenant files: its git configuration is refused; see the server log"
treeUnreadableText(symlinks, hidden) = "conf.d holds symlinks that cannot be resolved (dangling, looping, or with a non-directory in their path), and the route generator refuses a tree with any of them; nothing was written — repair or remove them in git (unreadable entries: 2)"
treeUnreadableText(symlinks, visible) = "conf.d holds symlinks that cannot be resolved (dangling, looping, or with a non-directory in their path), and the route generator refuses a tree with any of them; nothing was written — repair or remove them in git (unreadable entries: 2): tu-b.yaml (stat_error), sub (walk_error)"
treeUnreadableText(store fault, hidden) = "tenant-api's copy of conf.d holds entries the server cannot read (a FIFO, socket or device named like a config file, a file whose read fails, or a directory that cannot be listed); this is a storage problem on tenant-api's server or volume, not the configuration's content: repair it there or reset the copy from git; nothing was written (unreadable entries: 2)"
treeUnreadableText(store fault, visible) = "tenant-api's copy of conf.d holds entries the server cannot read (a FIFO, socket or device named like a config file, a file whose read fails, or a directory that cannot be listed); this is a storage problem on tenant-api's server or volume, not the configuration's content: repair it there or reset the copy from git; nothing was written (unreadable entries: 2): tu-b.yaml (stat_error), sub (walk_error)"
targetUnreadableText(special_file) = "tenant tu-a: its conf.d file is not a regular file (config_error: not_regular_file), so tenant-api neither reads nor replaces it; replace it with a regular file in git"
targetUnreadableText(read_error) = "tenant tu-a: its conf.d file tu-a.yaml cannot be read (config_error: unreadable), so tenant-api neither reads nor replaces it — replacing it would erase content nobody can read; repair it on tenant-api's server or volume, or in git"
GitManagedError(tenant_count).Error() = "tenant tu-a is git-managed (tenant_count): its config file is not one tenant-api writes (one YAML document declaring only this tenant, under the file's own name, without anchors, aliases, merge keys or tagged keys at the top level or directly under tenants:), so it is changed only through git; nothing was written"
findingsText(compared) = "the route generator refuses the configuration this write would produce; nothing was written"
findingsText(not compared) = "the route generator refuses the configuration this write would produce; nothing was written (not compared with the configuration before the write: pre_existing is not set)"
generatorUnavailableText(VALIDATOR_UNAVAILABLE, unreachable) = "the route generator container cannot judge writes (reason: unreachable), so content-changing writes are refused; nothing was written — the server log has the detail"
generatorUnavailableText(POLICY_UNAVAILABLE, policy_unusable) = "the deployment policy file the route generator judges with is unusable (reason: policy_unusable), so content-changing writes are refused; nothing was written — the server log has the detail"
generatorRejectedText(deadline) = "the route generator could not judge this write (deadline); nothing was written — retry — the server log has the detail"
generatorRejectedText(memory) = "the route generator could not judge this write (memory); nothing was written — the server log has the detail"
generatorRejectedText(incomplete) = "the route generator could not judge this write (incomplete); nothing was written — the server log has the detail"
generatorRejectedText(git_read) = "the route generator could not judge this write (git_read); nothing was written — retry — the server log has the detail"
generatorRejectedText(busy) = "the route generator could not judge this write (busy); nothing was written — retry — the server log has the detail"
generatorRejectedText(invalid_request) = "the route generator could not judge this write (invalid_request); nothing was written — the server log has the detail"
generatorRejectedText(mismatch) = "the route generator could not judge this write (mismatch); nothing was written — retry — the server log has the detail"
generatorRejectedText(no_time) = "the route generator could not judge this write (no_time); nothing was written — retry — the server log has the detail"
generatorRejectedText(normalized) = "the route generator could not judge this write (normalized); nothing was written — the server log has the detail"
generatorRejectedText(key_verdict_no_time) = "the route generator could not judge this write (key_verdict_no_time); nothing was written — retry — the server log has the detail"
generatorRejectedText(key_verdict_deadline) = "the route generator could not judge this write (key_verdict_deadline); nothing was written — retry — the server log has the detail"
generatorRejectedText(key_verdict_memory) = "the route generator could not judge this write (key_verdict_memory); nothing was written — the server log has the detail"
generatorRejectedText(key_verdict_error) = "the route generator could not judge this write (key_verdict_error); nothing was written — the server log has the detail"
generatorRejectedText(key_verdict_undecidable) = "the route generator could not judge this write (key_verdict_undecidable); nothing was written — the server log has the detail"
generatorRejectedText(key_verdict_platform_file) = "the route generator could not judge this write (key_verdict_platform_file); nothing was written — the server log has the detail"
generatorRejectedText(not_a_known_reason) = "the route generator could not judge this write (unknown); nothing was written — the server log has the detail"

