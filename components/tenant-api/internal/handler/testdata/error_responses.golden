entNormalized ≡ %w, gitops.ErrForgeDegraded ≡ %w, gitops.ErrGitTimeout ≡ %w, gitops.ErrMergeBaseNotLoadable ≡ %w, gitops.ErrMergeFailed ≡ %w, gitops.ErrMergeNoOp ≡ %w, gitops.ErrNoChanges ≡ %w, gitops.ErrNoValidator ≡ %w, gitops.ErrPendingPR ≡ %w, gitops.ErrPrecondition ≡ %w, gitops.ErrPushFailed ≡ %w, gitops.ErrTenantFileUnreadable ≡ %w, gitops.ErrTenantGitManaged ≡ %w, gitops.ErrTenantStoreFault ≡ %w, gitops.ErrTenantTreeUnreadable ≡ %w, gitops.ErrTreeNotOnBase ≡ %w, gitops.ErrWriteOutcomeUnknown ≡ %w, gitops.ErrWriteOverloaded ≡ %w, leavePRBranch(ErrTreeNotOnBase %w ErrGitTimeout), leavePRBranch(ErrTreeNotOnBase %w checkout err), leavePRBranch(back on base, retry), plain error (server path in text), platform.APIError{403, RateLimited}, platform.APIError{403}, platform.ErrCircuitOpen ≡ %w, platform.ErrForbidden ≡ %w, statestore.ErrConflict ≡ %w, statestore.ErrTooLarge ≡ %w, statestore.ErrUnavailable ≡ %w, tenantFileNotLoadableError, wrapped(generator.FindingsError)
