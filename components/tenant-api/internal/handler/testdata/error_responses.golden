### batchTaskError (runs that are not one error)
(run.Rejected) => "batch rejected: an operation was refused, so nothing in the batch was written; see results"
(run.Committed = c0ffee, Err = BatchCommittedError) => "the batch WAS committed, but the write did not finish cleanly on the server; refresh before changing anything (do not resend the batch blindly) (commit c0ffee)"
(run clean) => <nil>

### gateBatchOp / gateBatchOpPostStateAt (inputs are refusals, not errors)
gateBatchOp(invalid id Bad_ID, platform) => refused=true tenant=Bad_ID code=BAD_REQUEST message="tenant ID \"Bad_ID\" is not valid: Tenant id (ADR-035): a DNS-1123 label — 1-63 characters of lowercase letters, digits and '-', starting and ending with a letter or digit."
gateBatchOp(reserved id _defaults, platform) => refused=true tenant=_defaults code=BAD_REQUEST message="tenant ID must not name a reserved control file"
gateBatchOp(zz-other, team) => refused=true tenant=zz-other code=FORBIDDEN message="insufficient permissions for tenant zz-other"
gateBatchOp(tu-a, team) => refused=false
gateBatchOpPostStateAt(no _profile, team, zz-other) => refused=false
gateBatchOpPostStateAt(_profile, team, zz-other) => refused=true tenant=zz-other code=FORBIDDEN message="insufficient permissions for the tenant metadata this op proposes — its environment/domain would place tenant zz-other outside your scope (#1597)"
gateBatchOpPostStateAt(_profile, team, tu-a) => refused=false

## Part 3: the error kind table and its precedence (#3226)

### kindTable (kind => status code, then the attributes that are set)
fresh_base_scope => 403 FORBIDDEN
fresh_base_orgs => 500 CONFIG_DECODE_ERROR
generator_findings => 422 GENERATOR_FINDINGS
generator_rejected_retryable => 429 GENERATOR_BUSY retryable retry_after_s=5
generator_rejected => 422 GENERATOR_REJECTED
validator_unavailable => 503 VALIDATOR_UNAVAILABLE retryable retry_after_s=5
policy_unavailable => 503 POLICY_UNAVAILABLE retryable retry_after_s=5
tenant_tree_unreadable => 409 TENANT_TREE_UNREADABLE
tenant_store_fault => 500 TENANT_STORE_FAULT
tenant_file_unreadable => 409 TENANT_CONFIG_NOT_LOADABLE
tenant_git_managed => 409 TENANT_GIT_MANAGED client_error
tenant_git_managed_unnamed => 400 BAD_REQUEST client_error
tenant_declared_elsewhere => 409 TENANT_DECLARED_ELSEWHERE
tenant_tree_scan => 500 INTERNAL_ERROR
tenant_file_dirty => 409 TENANT_FILE_DIRTY
tenant_file_not_regular => 409 TENANT_CONFIG_NOT_LOADABLE client_error
tenant_config_not_loadable => 409 TENANT_CONFIG_NOT_LOADABLE
ambiguous_tenant_file => 409 TENANT_FILE_AMBIGUOUS client_error
precondition_failed => 409 CONFLICT retryable
conflict => 409 CONFLICT retryable
batch_committed => 409 BATCH_COMMITTED
git_push_failed => 503 GIT_PUSH_FAILED retryable retry_after_s=5
base_restore_failed => 500 BASE_RESTORE_FAILED
tree_not_on_base => 503 TREE_NOT_ON_BASE retryable retry_after_s=1
write_overloaded => 503 WRITE_OVERLOADED retryable retry_after_s=1
forge_degraded => 503 FORGE_UNAVAILABLE retryable retry_after_s=5
write_outcome_unknown => 503 WRITE_OUTCOME_UNKNOWN
write_cancelled => 503 UPSTREAM_ERROR retryable
git_driver_configured => 500 GIT_DRIVER_CONFIGURED fault
git_config_unreadable => 503 UPSTREAM_ERROR retryable retry_after_s=5
no_changes => 200 -
validation => 400 BAD_REQUEST client_error
invalid_tenant_id => 400 BAD_REQUEST client_error
reserved_tenant_id => 400 BAD_REQUEST client_error
merge_failed => 400 BAD_REQUEST client_error
forbidden => 403 FORBIDDEN
bad_request => 400 BAD_REQUEST client_error
state_conflict => 409 CONFLICT retryable
state_unavailable => 503 UPSTREAM_ERROR retryable retry_after_s=5
state_full => 507 STATE_FULL
config_file_parse => 500 CONFIG_DECODE_ERROR
forge_forbidden => 403 FORGE_FORBIDDEN fault
forge_circuit_open => 503 FORGE_UNAVAILABLE retryable retry_after_s=5
forge_create_failed => 503 UPSTREAM_ERROR retryable retry_after_s=5
federation_token_limit => 409 TOKEN_LIMIT_REACHED
federation_mint_rate_limited => 429 RATE_LIMITED retryable retry_after_s=60
federation_not_configured => 503 FEDERATION_NOT_CONFIGURED
route_not_found => 404 NOT_FOUND client_error
method_not_allowed => 405 METHOD_NOT_ALLOWED client_error
request_timeout => 504 REQUEST_TIMEOUT
stream_unsupported => 500 INTERNAL_ERROR fault
server_shutting_down => 503 UPSTREAM_ERROR retryable retry_after_s=1
internal => 500 INTERNAL_ERROR fault

### kindRules precedence: each rule's sample wrapped around the next rule's sample
### ("a > b": an error that is both is answered as a; the winner when no entry narrows the kinds)
fresh_base_scope > fresh_base_orgs => fresh_base_scope
fresh_base_orgs > generator_findings => fresh_base_orgs
generator_findings > generator_rejected_retryable => generator_findings
generator_rejected_retryable > generator_rejected => generator_rejected_retryable
generator_rejected > validator_unavailable => generator_rejected
validator_unavailable > policy_unavailable => validator_unavailable
policy_unavailable > tenant_tree_unreadable => policy_unavailable
tenant_tree_unreadable > tenant_store_fault => tenant_tree_unreadable
tenant_store_fault > tenant_file_unreadable => tenant_store_fault
tenant_file_unreadable > tenant_git_managed => tenant_file_unreadable
tenant_git_managed > tenant_config_not_loadable => tenant_git_managed
tenant_config_not_loadable > tenant_declared_elsewhere => tenant_config_not_loadable
tenant_declared_elsewhere > tenant_tree_scan => tenant_declared_elsewhere
tenant_tree_scan > tenant_file_dirty => tenant_tree_scan
tenant_file_dirty > git_driver_configured => tenant_file_dirty
git_driver_configured > git_config_unreadable => git_driver_configured
git_config_unreadable > invalid_tenant_id => git_config_unreadable
invalid_tenant_id > write_overloaded => invalid_tenant_id
write_overloaded > forge_degraded => write_overloaded
forge_degraded > ambiguous_tenant_file => forge_degraded
ambiguous_tenant_file > batch_committed => ambiguous_tenant_file
batch_committed > tree_not_on_base => batch_committed
tree_not_on_base > precondition_failed => tree_not_on_base
precondition_failed > conflict => precondition_failed
conflict > git_push_failed => conflict
git_push_failed > validation => git_push_failed
validation > base_restore_failed => validation
base_restore_failed > reserved_tenant_id => base_restore_failed
reserved_tenant_id > merge_failed => reserved_tenant_id
merge_failed > tenant_git_managed_unnamed => merge_failed
tenant_git_managed_unnamed > tenant_file_not_regular => tenant_git_managed_unnamed
tenant_file_not_regular > state_conflict => tenant_file_not_regular
state_conflict > state_unavailable => state_conflict
state_unavailable > state_full => state_unavailable
state_full > config_file_parse => state_full
config_file_parse > forge_forbidden => config_file_parse
forge_forbidden > forge_circuit_open => forge_forbidden
forge_circuit_open > federation_token_limit => forge_circuit_open
federation_token_limit > federation_mint_rate_limited => federation_token_limit
federation_mint_rate_limited > write_outcome_unknown => federation_mint_rate_limited
write_outcome_unknown > write_cancelled => write_outcome_unknown
write_cancelled > no_changes => write_cancelled
no_changes > stream_unsupported => no_changes
stream_unsupported > server_shutting_down => stream_unsupported
