# writeIssueError (a federation token mint Issue / IssueLogs refused)
plain error (server path in text) => 500 INTERNAL_ERROR error="internal error; the server log has the details under this request_id"
token.ErrTokenLimitReached => 409 TOKEN_LIMIT_REACHED error="federation: tenant federation-token limit reached"
wrapped(token.ErrTokenLimitReached) => 409 TOKEN_LIMIT_REACHED error="op ctx: federation: tenant federation-token limit reached"
