# Copy to .env and edit as needed:  cp .env.example .env
#
# ── Component image tags ─────────────────────────────────────────────────
# Per-line versioning (the platform ships 5 independent version lines), so
# each component is pinned separately — a single shared IMAGE_TAG would break
# the moment one component is bumped on its own. Image tag form is ":v2.8.0".
EXPORTER_TAG=v2.8.0
PORTAL_TAG=v2.8.0
# NOTE: tenant-api BUILDS FROM SOURCE. ⛔ The reason written here used to be
# "the --dev-bypass-auth flag it needs (#619 / ADR-022) isn't in a published
# image yet". That is FALSE: the flag ships from tenant-api/v2.9.7 onward.
# #1337 corrected the identical sentence in docker-compose.yaml and left this
# copy standing. The real reason it still builds from source is that switching
# changes what the demo RUNS (auth path, arch, first-boot time), which is
# deliberately not bundled with a pinning change.
# ⚠️ TENANT_API_TAG is read by nothing today (docker-compose.yaml uses build:),
# and the value below PREDATES the flag — swapping build:→image: without also
# bumping it brings the stack up with no --dev-bypass-auth.
TENANT_API_TAG=v2.8.0
# da-tools is a CLI image (not a compose service). Used by the optional
# `docker run ghcr.io/vencil/da-tools:$TOOLS_TAG guard ...` one-liner in README.
TOOLS_TAG=v2.8.0

# ── Host ports (change any that collide with something already running) ──
EXPOSE_API_PORT=8080         # tenant-api
EXPOSE_PORTAL_PORT=8081      # da-portal (Tenant Manager UI)
EXPOSE_PREVIEW_PORT=8082     # recipe-preview (would-fire POST /preview; #657)
EXPOSE_PROM_PORT=9090        # prometheus (/alerts)
EXPOSE_AM_PORT=9093          # alertmanager
EXPOSE_PUSHGATEWAY_PORT=9091 # pushgateway
EXPOSE_GRAFANA_PORT=3000     # grafana (federation-revocation security dashboard)
