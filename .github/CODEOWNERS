helm/threshold-exporter/Chart.yaml                          @vencil
helm/threshold-exporter/values.yaml                         @vencil
.github/custom-rule-policy.yaml                             @vencil

# ============================================================
# 租戶設定（示意歸屬：各 Tenant Team 擁有自己的檔案）
#
# 有 org 的環境會是每個租戶一行、指向該租戶的團隊：
#   components/threshold-exporter/config/conf.d/<tenant>.yaml  @<org>/team-<tenant>
# db-a / db-b 是 repo 內的示範租戶。
# ============================================================
